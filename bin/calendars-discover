#!/usr/bin/env python3
"""Reads one JSON discovery request from stdin -- {"url","username","password"}
-- and writes the discovered calendars as JSON to stdout.

Kept separate from calendars-sync: this is pure discovery and never touches
feeds.json, so a password typed into the discovery form and never actually
added afterwards is never even momentarily written to disk. Credentials
arrive over stdin rather than argv for the same reason calendars-sync's feed
URLs do: process arguments are world-readable via /proc/<pid>/cmdline.
"""
import json
import sys

from _caldav import discover_calendars


def main():
    try:
        request = json.loads(sys.stdin.readline())
    except (json.JSONDecodeError, TypeError):
        request = None
    if not isinstance(request, dict):
        sys.stdout.write(json.dumps({"ok": False, "error": "malformed discovery request", "calendars": []}))
        return 0

    result = discover_calendars(
        request.get("url", ""), request.get("username", ""), request.get("password", ""))
    sys.stdout.write(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
